# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# These keys are read by the SERVER (see server/apis.js), never by the Angular
# app. They are not compiled into the browser bundle and are not visible to
# anyone using the site.
#
# .env is gitignored and must never be committed. On a host such as Hostinger
# there is no .env file — set these same names as environment variables in the
# control panel instead.
#
# Without a key, that room returns 503 and says which variable is missing.
# The rest of the site works normally. Most rooms need no key at all.

# Giphy. Used by the gif room.
# https://developers.giphy.com/dashboard/
GIFS_API_KEY=

# Pexels. Used by the photo room.
# https://www.pexels.com/api/
PEXELS_API_KEY=

# The Movie Database. Used by the video room.
# Replaces imdb-api.com, which shut down and no longer resolves.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Port for the server. Defaults to 3000. The host usually sets this itself.
# PORT=3000
